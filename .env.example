# Copia a .env y rellena. NO subas .env al repo.

# ===== Scraper (Gemini Flash) =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SCRAPER_CONCURRENCY=5
SCRAPER_MAX_PAGES=25
SCRAPER_TIMEOUT=20
SCRAPER_MAX_MD_CHARS=18000
SCRAPER_OUTPUT=data/scraped.json

# ===== Canal WhatsApp (Kapso) — usado por channel/ =====
KAPSO_API_KEY=
KAPSO_API_BASE_URL=https://api.kapso.ai
META_GRAPH_VERSION=v24.0
# ID Meta del número conectado (descubrir con: node scripts/list-platform-phone-numbers.mjs)
KAPSO_PHONE_NUMBER_ID=
# Secreto del webhook para verificar la firma HMAC X-Webhook-Signature
KAPSO_WEBHOOK_SECRET=
KAPSO_WEBHOOK_PATH=/webhooks/kapso

# ===== Notificación interna del lead (modelo broker) =====
# Número de nuestro equipo (E.164, p.ej. +5215512345678) que recibe el lead por WhatsApp.
# OPCIONAL si usas el correo (abajo) como handoff principal.
INTERNAL_NOTIFY_NUMBER=
LEAD_TEMPLATE_NAME=nuevo_lead_visita
LEAD_TEMPLATE_LANGUAGE=es_MX

# ===== Correo del lead (handoff + documentación) =====
# Manda un correo por cada lead con el resumen, a quién escribir y el mensaje ya redactado.
# Gmail: crea un "App Password" (cuenta con 2FA → Seguridad → Contraseñas de aplicación).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tucorreo@gmail.com
SMTP_PASSWORD=           # App Password de 16 dígitos (NO tu contraseña normal)
LEAD_EMAIL_TO=tucorreo@gmail.com   # a dónde llega el lead
LEAD_EMAIL_FROM=                    # opcional; default = SMTP_USER

# ===== Supabase (loader db/load_to_supabase.py) =====
# Connection string directa: Project Settings > Database > Connection string > URI
SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
